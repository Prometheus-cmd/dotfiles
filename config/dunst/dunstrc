[global]
    ### Display ###
    monitor = 0
    follow = mouse
    
    # Position (Change to top_center or top_left if preferred)
    origin = top-right
    offset = 20x20
    
    # Appearance
    width = 300
    height = 110
    notification_limit = 5
    padding = 15
    horizontal_padding = 15
    frame_width = 2
    border_radius = 10
    
    # Tokyo Night Colors
    separator_color = "#414868"
    font = Iosevka Nerd Font 10
    line_height = 4

[urgency_low]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#414868"
    timeout = 5

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#7aa2f7" # Tokyo Night Blue
    timeout = 10

[urgency_critical]
    background = "#1a1b26"
    foreground = "#f7768e" # Tokyo Night Red
    frame_color = "#f7768e"
    timeout = 0
