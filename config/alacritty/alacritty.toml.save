[font]
normal = { family = "IosevkaTerm Nerd Font", style = "Regular" }
size = 12

[colors.primary]
background = "#1a1b26"
foreground = "#c0caf5"

[colors.normal]
black   = "#15161e"
red     = "#f7768e"
green   = "#9ece6a"
yellow  = "#e0af68"
blue    = "#7aa2f7"
magenta = "#bb9af7"
cyan    = "#7dcfff"
white   = "#a9b1d6"

[terminal]

[terminal.shell]
program = "/bin/bash"
args = ["--login"]

[window]
opacity = 1  # Adjust this to your liking
padding = { x = 20, y = 20 }
decorations = "none" # Removes the title bar for a cleaner look
